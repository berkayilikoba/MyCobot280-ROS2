# LIMO Robotu Jetson ROS 2 Humble Dockerfile (Ubuntu 20.04 / L4T r35)
ARG BASE_IMAGE=dustynv/ros:humble-ros-base-l4t-r35.4.1
FROM ${BASE_IMAGE}

# Argümanlar ve ortam değişkenleri
ARG NAV2_PACKAGES="navigation2 nav2_bringup slam_toolbox robot_localization tf_transformations"
ARG PARALLEL_WORKERS=2
ARG MAKEFLAGS="-j2"

ENV UNDERLAY=/opt/nav2_ws
ENV LIMO_WS=/opt/limo_ws
ENV DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-c"]

# Temel derleme araçları ve ROS 2 yardımcı paketleri
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    libboost-all-dev \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-rosinstall-generator \
    python3-vcstool \
 && rm -rf /var/lib/apt/lists/*

# rosdep başlatma ve güncelleme
RUN [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ] && rosdep init || true \
 && rosdep update

# Nav2 ve eksik paketler (Underlay)
WORKDIR ${UNDERLAY}
RUN source /opt/ros/humble/install/setup.bash \
 && export ROS_PACKAGE_PATH=${AMENT_PREFIX_PATH} \
 && mkdir -p ${UNDERLAY}/src \
 && rosinstall_generator ${NAV2_PACKAGES} --deps --exclude RPP --rosdistro humble > nav2.rosinstall \
 && vcs import src < nav2.rosinstall \
 && apt-get update \
 && rosdep install --from-paths src --ignore-src -y \
    --skip-keys "gazebo11 libgazebo11-dev gazebo_ros gazebo_ros_pkgs gazebo_plugins libgazebo_ros gazebo rviz2 rviz_common rviz_default_plugins joint_state_publisher_gui rqt_robot_steering turtlesim teleop_twist_keyboard libopencv-dev python3-opencv cv_bridge" \
 && rm -rf /var/lib/apt/lists/* \
 && export MAKEFLAGS="${MAKEFLAGS}" \
 && colcon build \
    --merge-install \
    --parallel-workers ${PARALLEL_WORKERS} \
    --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
 && rm -rf ${UNDERLAY}/src ${UNDERLAY}/build ${UNDERLAY}/log

# YDLidar-SDK kurulumu
RUN git clone --depth 1 -b master https://github.com/YDLIDAR/YDLidar-SDK.git /tmp/YDLidar-SDK \
 && mkdir -p /tmp/YDLidar-SDK/build \
 && cd /tmp/YDLidar-SDK/build \
 && cmake -DCMAKE_BUILD_TYPE=Release .. \
 && export MAKEFLAGS="${MAKEFLAGS}" \
 && make \
 && make install \
 && ldconfig \
 && rm -rf /tmp/YDLidar-SDK

# LIMO Çalışma Alanı (Overlay)
WORKDIR ${LIMO_WS}
COPY src/ ${LIMO_WS}/src/
RUN git clone --depth 1 -b humble https://github.com/YDLIDAR/ydlidar_ros2_driver.git ${LIMO_WS}/src/ydlidar_ros2_driver \
 && source /opt/ros/humble/install/setup.bash \
 && source ${UNDERLAY}/install/setup.bash \
 && apt-get update \
 && rosdep install --from-paths src --ignore-src -y \
    --skip-keys "gazebo11 libgazebo11-dev gazebo_ros gazebo_ros_pkgs gazebo_plugins libgazebo_ros gazebo rviz2 rviz_common rviz_default_plugins joint_state_publisher_gui rqt_robot_steering turtlesim teleop_twist_keyboard libopencv-dev python3-opencv cv_bridge" \
 && rm -rf /var/lib/apt/lists/* \
 && export MAKEFLAGS="${MAKEFLAGS}" \
 && colcon build \
    --parallel-workers ${PARALLEL_WORKERS} \
    --packages-up-to limo_bringup limo_autonomy ydlidar_ros2_driver \
    --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF

# Giriş betiği ve çalışma ortamı
COPY docker/entrypoint.sh /limo_entrypoint.sh
RUN chmod +x /limo_entrypoint.sh

ENTRYPOINT ["/limo_entrypoint.sh"]
CMD ["bash"]
