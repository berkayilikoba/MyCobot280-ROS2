<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mycobot_280">

  <!-- Link 1 (Base of the arm) -->
  <link name="joint1">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot/joint1.dae"/>
      </geometry>
      <origin xyz="0.0 0 0" rpy="0 0 -1.5708"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.08"/>
      </geometry>
      <origin xyz="0.0 0 0.04" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="1.5e-4" ixy="0.0" ixz="0.0" iyy="1.5e-4" iyz="0.0" izz="1.5e-4"/>
    </inertial>
  </link>

  <!-- Joint 1 to 2 (-168 to +168 deg) -->
  <joint name="joint2_to_joint1" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-2.9322" upper="2.9322" velocity="1.5"/>
    <dynamics damping="0.5" friction="1.0"/>
    <parent link="joint1"/>
    <child link="joint2"/>
    <origin xyz="0 0 0.13156" rpy="0 0 0"/>
  </joint>

  <!-- Link 2 -->
  <link name="joint2">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot/joint2.dae"/>
      </geometry>
      <origin xyz="0.0 0 -0.06096" rpy="0 0 -1.5708"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.09"/>
      </geometry>
      <origin xyz="0.0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.13"/>
      <inertia ixx="1.3e-4" ixy="0.0" ixz="0.0" iyy="1.3e-4" iyz="0.0" izz="1.3e-4"/>
    </inertial>
  </link>

  <!-- Joint 2 to 3 (-135 to +135 deg) -->
  <joint name="joint3_to_joint2" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-2.3562" upper="2.3562" velocity="1.5"/>
    <dynamics damping="0.5" friction="1.0"/>
    <parent link="joint2"/>
    <child link="joint3"/>
    <origin xyz="0 0 0" rpy="0 1.5708 -1.5708"/>
  </joint>

  <!-- Link 3 -->
  <link name="joint3">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot/joint3.dae"/>
      </geometry>
      <origin xyz="0.0 0 0.03256" rpy="0 -1.5708 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.11"/>
      </geometry>
      <origin xyz="-0.055 0 0" rpy="0 1.5708 0"/>
    </collision>
    <inertial>
      <origin xyz="-0.055 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="1.2e-4" ixy="0.0" ixz="0.0" iyy="1.2e-4" iyz="0.0" izz="1.2e-4"/>
    </inertial>
  </link>

  <!-- Joint 3 to 4 (-150 to +150 deg) -->
  <joint name="joint4_to_joint3" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-2.6180" upper="2.6180" velocity="1.5"/>
    <dynamics damping="0.5" friction="1.0"/>
    <parent link="joint3"/>
    <child link="joint4"/>
    <origin xyz="-0.1104 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Link 4 -->
  <link name="joint4">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot/joint4.dae"/>
      </geometry>
      <origin xyz="0.0 0 0.03056" rpy="0 -1.5708 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.10"/>
      </geometry>
      <origin xyz="-0.048 0 0" rpy="0 1.5708 0"/>
    </collision>
    <inertial>
      <origin xyz="-0.048 0 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="1.0e-4" ixy="0.0" ixz="0.0" iyy="1.0e-4" iyz="0.0" izz="1.0e-4"/>
    </inertial>
  </link>

  <!-- Joint 4 to 5 (-145 to +145 deg) -->
  <joint name="joint5_to_joint4" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-2.5307" upper="2.5307" velocity="1.5"/>
    <dynamics damping="0.5" friction="1.0"/>
    <parent link="joint4"/>
    <child link="joint5"/>
    <origin xyz="-0.096 0 0.06462" rpy="0 0 -1.5708"/>
  </joint>

  <!-- Link 5 -->
  <link name="joint5">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot/joint5.dae"/>
      </geometry>
      <origin xyz="0.0 0 -0.03356" rpy="-1.5708 0 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.025" length="0.07"/>
      </geometry>
      <origin xyz="0 -0.036 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 -0.036 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="1.0e-4" ixy="0.0" ixz="0.0" iyy="1.0e-4" iyz="0.0" izz="1.0e-4"/>
    </inertial>
  </link>

  <!-- Joint 5 to 6 (-165 to +165 deg) -->
  <joint name="joint6_to_joint5" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-2.8798" upper="2.8798" velocity="1.5"/>
    <dynamics damping="0.5" friction="1.0"/>
    <parent link="joint5"/>
    <child link="joint6"/>
    <origin xyz="0 -0.07318 0" rpy="1.5708 -1.5708 0"/>
  </joint>

  <!-- Link 6 -->
  <link name="joint6">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot/joint6.dae"/>
      </geometry>
      <origin xyz="0 0.00 -0.038" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.025" length="0.05"/>
      </geometry>
      <origin xyz="0 0.02 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0.02 0" rpy="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="1.0e-4" ixy="0.0" ixz="0.0" iyy="1.0e-4" iyz="0.0" izz="1.0e-4"/>
    </inertial>
  </link>

  <!-- Joint 6 to 6_flange (-175 to +175 deg) -->
  <joint name="joint6output_to_joint6" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-3.0543" upper="3.0543" velocity="1.5"/>
    <dynamics damping="0.5" friction="1.0"/>
    <parent link="joint6"/>
    <child link="joint6_flange"/>
    <origin xyz="0 0.0456 0" rpy="-1.5708 0 0"/>
  </joint>

  <!-- Link 6 Flange -->
  <link name="joint6_flange">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot/joint7.dae"/>
      </geometry>
      <origin xyz="0.0 0 -0.012" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.02" length="0.015"/>
      </geometry>
      <origin xyz="0.0 0 -0.0075" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.0075" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1.0e-4" ixy="0.0" ixz="0.0" iyy="1.0e-4" iyz="0.0" izz="1.0e-4"/>
    </inertial>
  </link>

</robot>
