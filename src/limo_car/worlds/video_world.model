<?xml version="1.0" ?>
<!--
  LIMO simülasyon dünyası.

  ackermann_gazebo.launch.py:25 bu dosyayı adıyla istiyor ama upstream'de
  worlds/ dizini hiç yoktu; gzserver var olmayan bir dosyayla başlatılıyordu.

  İçerik bilinçli olarak sade: zemin, ışık ve Nav2'nin costmap'inde görünecek
  kadar engel. LIMO 0.30 x 0.20 m; koridor genişlikleri buna göre seçildi
  (dar geçiş 0.8 m — inflation_radius 0.15 ile planlanabilir olmalı).
-->
<sdf version="1.6">
  <world name="default">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <shadows>false</shadows>
    </scene>

    <!-- Dış duvarlar: 8 x 8 m kapalı alan -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.1 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.1 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>4 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 8 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 8 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-4 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 8 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 8 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Orta bölme: Hybrid-A*'ın dönüş yarıçapı kısıtını sınamak için.
         Robotun etrafından dolaşması gerekir, yerinde dönemez. -->
    <model name="divider">
      <static>true</static>
      <pose>0 0.6 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4 0.1 0.5</size></box></geometry>
          <material><ambient>0.5 0.3 0.2 1</ambient><diffuse>0.6 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tekil engeller: local costmap ve MPPI'nin kaçınma davranışı için -->
    <model name="pillar_a">
      <static>true</static>
      <pose>2.0 -2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.2 0.3 0.5 1</ambient><diffuse>0.3 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_b">
      <static>true</static>
      <pose>-2.0 -1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.2 0.3 0.5 1</ambient><diffuse>0.3 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

  
    <!-- Video kaydı için üstten bakan kamera (scripts/video_run.sh + video_recorder.py). Geri kalanı empty_world.model ile aynı. -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0 0 10 0 1.5708 1.5708</pose>
      <link name="link">
        <sensor name="overhead" type="camera">
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>0.8455</horizontal_fov>
            <image><width>720</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>30</far></clip>
          </camera>
          <plugin name="overhead_cam" filename="libgazebo_ros_camera.so">
            <ros><namespace>/overhead</namespace></ros>
            <camera_name>cam</camera_name>
            <frame_name>overhead_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
